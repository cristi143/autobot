# autobot.dunitru.ro
# Forțează https.
#
# Comutatorul „Force HTTPS Redirect" din cPanel nu e disponibil pe acest pachet
# de găzduire — dă „You do not have the feature sslinstall". Certificatul
# Let's Encrypt există însă, deci facem redirecționarea noi.
#
# A doua condiție e pentru cazul în care TLS-ul se termină într-un proxy din
# fața serverului: acolo %{HTTPS} poate fi „off" deși vizitatorul e pe https,
# iar fără verificarea antetului s-ar face o buclă infinită de redirecționări.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

DirectoryIndex index.html
Options -Indexes

AddType application/json .json

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Nimic nu se ține în cache.
#
# Regula de dinainte păstra CSS-ul și JS-ul o zi întreagă. Era potrivită pentru
# o pagină statică, dar aici aplicația se schimbă de câteva ori pe oră: după un
# deploy, browserul continua să ruleze codul vechi fără ca nimic să pară în
# neregulă — cel mai enervant fel de greșeală, pentru că arată ca un cod care
# nu funcționează.
#
# Fișierele sunt mici (zeci de kiloocteți). Revalidarea costă o cerere care de
# obicei întoarce 304, adică aproape nimic.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "\.(html|js|css|json)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
</IfModule>
